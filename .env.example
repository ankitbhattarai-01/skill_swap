VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Required when Supabase Auth CAPTCHA protection is enabled.
# Set exactly one public site key to match the provider selected in Supabase.
VITE_TURNSTILE_SITE_KEY=""
VITE_HCAPTCHA_SITE_KEY=""

# n8n webhook secrets - set with `supabase secrets set ...`, NOT here.
# N8N_RECOMMENDATION_WEBHOOK_URL, N8N_CREDIT_TRANSFER_WEBHOOK_URL, N8N_WEBHOOK_SECRET

# Jitsi video rooms
# JaaS (8x8.vc) is the only supported provider — the public meet.jit.si
# fallback was removed because it has no per-room authorization. When
# VITE_JAAS_APP_ID is unset the in-app video routes render a "video not
# configured" placeholder; chat and scheduling still work.

# Optional override for the JaaS domain (defaults to 8x8.vc).
VITE_JITSI_DOMAIN=""

# JaaS (8x8.vc) tenant - the App ID looks like vpaas-magic-cookie-XXXXXXXX...
# Public value, safe to expose to the browser. Leave blank to disable
# in-app video calls entirely.
VITE_JAAS_APP_ID=""

# JaaS Edge Function secrets - set with `supabase secrets set ...`, NOT here.
# JAAS_APP_ID, JAAS_KEY_ID, JAAS_PRIVATE_KEY (PEM)

# Session email pipeline (Gmail SMTP) — set with `supabase secrets set ...`, NOT here.
# See docs/EMAIL_SETUP.md for the full setup walkthrough.
#   GMAIL_USER            - sender Gmail address (e.g. utsab@gmail.com)
#   GMAIL_APP_PASSWORD    - 16-char App Password from myaccount.google.com/apppasswords
#   GMAIL_FROM_NAME       - display name shown in inbox (e.g. "SkillSwap Connect")
#   EMAIL_WEBHOOK_SECRET  - long random string; also stored in private.email_dispatch_config
#   APP_PUBLIC_URL        - production app URL used in email CTAs (no trailing slash)

# Edge Function CORS allowlist — set with `supabase secrets set ...`, NOT here.
# Comma-separated production origins consumed by supabase/functions/_shared/cors.ts.
# Localhost dev ports are always allowed; this var adds the deployed origins.
#   CORS_ALLOWED_ORIGINS  - e.g. "https://skillswap.example.com,https://staging.example.com"

# AI suggestion provider keys — set with `supabase secrets set ...`, NOT here.
# generate-suggestions tries Groq first and falls back to Gemini, so either
# is enough on its own; ship both for resilience. With neither set the
# Edge Function returns 500 and the dashboard surfaces a "suggestions
# unavailable" state.
#   GROQ_API_KEY    - from https://console.groq.com/keys
#   GEMINI_API_KEY  - from https://aistudio.google.com/apikey

# AI session notes (generate-session-notes) — set with `supabase secrets set ...`, NOT here.
# Deliberately SEPARATE Gemini keys from GEMINI_API_KEY above, ideally from
# different Google accounts/projects. Audio requests are far heavier than the
# text suggestion prompts, so sharing one free-tier quota would let a few long
# recordings starve the dashboard's AI Suggestions. Up to five keys are tried
# in order — ANY failure on one (rate limit, quota, bad key, model error)
# falls through to the next, same convention as GEMINI_VERIFY_API_KEY_2…_5.
# For real redundancy put each key in a DIFFERENT Google project so they don't
# share a quota bucket. With none set, the "AI Notes" button returns a "not
# configured" error and the rest of the video call works normally.
#   GEMINI_NOTES_API_KEY        - main key, from https://aistudio.google.com/apikey
#   GEMINI_NOTES_API_KEY_2 … _5 - optional fallbacks, same source

# Practice problems (practice-questions) — set with `supabase secrets set ...`, NOT here.
# Powers the /practice page's LeetCode-lite problem generator. Up to SIX keys are
# tried in order (1 main + 5 fallbacks); ANY failure on one (rate limit, quota,
# bad key, model error) falls through to the next — same convention as the verify
# and notes keys. If none of these are set, the function falls back to the
# GEMINI_VERIFY_API_KEY(_2…_5) keys, so Practice works with keys you already have.
# For real redundancy put each key in a DIFFERENT Google project so they don't
# share a quota bucket. With no keys at all the Practice page shows a friendly
# "not configured" error and the rest of the app is unaffected.
#   GEMINI_PRACTICE_API_KEY        - main key, from https://aistudio.google.com/apikey
#   GEMINI_PRACTICE_API_KEY_2 … _6 - optional fallbacks, same source
